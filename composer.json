{
  "name": "ondrejbalko/euro-sms",
  "description": "PHP client for the EuroSMS gateway: sending, delivery statuses, CallBack notifications and Viber over SMS API v3.1.15.",
  "type": "library",
  "keywords": [
    "sms",
    "eurosms",
    "sms-gateway",
    "viber",
    "delivery-report",
    "notifications",
    "slovakia",
    "psr-18"
  ],
  "homepage": "https://github.com/ondrejbalko/euro-sms",
  "authors": [
    {
      "name": "Ondrej Balko",
      "email": "ondrej.balko@gmail.com"
    }
  ],
  "license": "GPL-3.0-only",
  "minimum-stability": "stable",
  "require": {
    "php": ">=8.5",
    "ext-json": "*",
    "ext-mbstring": "*",
    "giggsey/libphonenumber-for-php-lite": "^9.0",
    "guzzlehttp/guzzle": "^7.15",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.1",
    "psr/http-message": "^2.0",
    "psr/log": "^3.0",
    "ramsey/uuid": "^4.9"
  },
  "autoload": {
    "psr-4": {
      "EuroSms\\": "./src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "EuroSms\\Tests\\": "./tests/"
    }
  },
  "scripts": {
    "phpstan": "vendor/bin/phpstan analyse",
    "phpunit": "vendor/bin/phpunit",
    "phpunit-coverage": "vendor/bin/phpunit --coverage-html cache/build/coverage --coverage-clover cache/build/clover.xml"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.0",
    "symfony/var-dumper": "^8.1"
  },
  "config": {
    "sort-packages": true
  }
}
